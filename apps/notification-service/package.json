{
  "name": "@marketplace/notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@marketplace/common": "workspace:*",
    "@marketplace/contracts": "workspace:*",
    "@marketplace/messaging": "workspace:*",
    "@prisma/client": "6.19.3",
    "express": "^5.3.0",
    "nodemailer": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.0",
    "prisma": "6.19.3"
  }
}
