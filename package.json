{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --recursive --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:event": "tsx scripts/test-event.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:catalog": "tsx scripts/test-catalog.ts",
    "test:cart": "tsx scripts/test-cart.ts",
    "test:order": "tsx scripts/test-order.ts",
    "test:sse": "tsx scripts/test-sse.ts",
    "test:notification": "tsx scripts/test-notification.ts",
    "prisma:generate": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres pnpm --recursive --workspace-concurrency=1 --if-present prisma:generate",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres pnpm --recursive --workspace-concurrency=1 --if-present prisma:validate",
    "infra:up": "docker compose -f deploy/compose/docker-compose.yml up -d --build --wait",
    "infra:down": "docker compose -f deploy/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@marketplace/common": "workspace:*",
    "@marketplace/contracts": "workspace:*",
    "@marketplace/messaging": "workspace:*",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
